<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="login_container" stylesheets="@../Styles/login.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jdm.agenda.Controllers.LoginController">
   <ImageView fitHeight="600.0" fitWidth="1100.0" pickOnBounds="true" preserveRatio="true" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <image>
         <Image url="@../Imgs/img_fundo.jpg" />
      </image>
   </ImageView>
    <Pane id="login_back" layoutX="163.0" layoutY="66.0" prefHeight="468.0" prefWidth="675.0" AnchorPane.bottomAnchor="66.0" AnchorPane.leftAnchor="163.0" AnchorPane.rightAnchor="162.0" AnchorPane.topAnchor="66.0">
        <Pane id="form_login" layoutX="32.0" layoutY="18.0" prefHeight="432.0" prefWidth="306.0">
            <Label id="lbl_Painel" fx:id="painel_lbl" alignment="CENTER" contentDisplay="CENTER" layoutX="75.0" layoutY="38.0" text="Painel de Login">
                <font>
                    <Font size="22.0" />
                </font>
            </Label>
            <TextField id="txt_user" fx:id="usuario_fld" layoutX="39.0" layoutY="157.0" prefHeight="32.0" prefWidth="220.0" promptText="Usuário">
                <font>
                    <Font size="13.0" />
                </font>
            </TextField>
            <Button id="login_button" fx:id="btn_login" layoutX="50.0" layoutY="295.0" mnemonicParsing="false" prefHeight="26.0" prefWidth="198.0" text="Entrar" textFill="WHITE">
                <font>
                    <Font size="15.0" />
                </font>
            </Button>
            <Label fx:id="error_lbl" layoutX="39.0" layoutY="367.0" text="Error :" textFill="RED" visible="false">
            <font>
               <Font size="13.0" />
            </font></Label>
         <PasswordField id="txt_senha" fx:id="senha_fld" layoutX="39.0" layoutY="216.0" prefHeight="31.0" prefWidth="220.0" promptText="Senha">
            <font>
               <Font size="13.0" />
            </font>
         </PasswordField>
        </Pane>
        <Pane id="Painel_dados_login" layoutX="369.0" layoutY="18.0" prefHeight="198.0" prefWidth="276.0">
            <ProgressBar id="barra_prog1" fx:id="progresso_nivel2" layoutX="52.0" layoutY="110.0" prefHeight="23.0" prefWidth="172.0" progress="0.09" />
            <ProgressBar id="barra_prog2" fx:id="progresso_nivel1" layoutX="52.0" layoutY="150.0" prefHeight="23.0" prefWidth="172.0" progress="0.18" />
            <Label id="lbl_Painel" fx:id="quantidadeLogin_lbl" alignment="CENTER" contentDisplay="CENTER" layoutX="63.0" layoutY="39.0" text="Quantidade Login">
                <font>
                    <Font size="20.0" />
                </font>
            </Label>
        </Pane>
        <RadioButton fx:id="rdb_nivel2" layoutX="413.0" layoutY="313.0" mnemonicParsing="false" text="Nível 2">
            <font>
                <Font size="15.0" />
            </font>
        </RadioButton>
        <RadioButton fx:id="rdb_nivel1" layoutX="413.0" layoutY="351.0" mnemonicParsing="false" text="Nível 1">
            <font>
                <Font size="15.0" />
            </font>
        </RadioButton>
        <Circle fill="#f06595" layoutX="520.0" layoutY="324.0" radius="11.0" stroke="TRANSPARENT" strokeType="INSIDE" />
        <Circle fill="#74c0fc" layoutX="520.0" layoutY="362.0" radius="11.0" stroke="TRANSPARENT" strokeType="INSIDE" />
      <Line endX="-20.0" layoutX="516.0" layoutY="336.0" startX="-100.0" stroke="#f06998" />
      <Line endX="-20.0" layoutX="516.0" layoutY="373.0" startX="-100.0" stroke="#74c0fc" />
      <Text layoutX="412.0" layoutY="280.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Selecione um Nível">
         <font>
            <Font size="20.0" />
         </font>
      </Text>
    </Pane>
</AnchorPane>
