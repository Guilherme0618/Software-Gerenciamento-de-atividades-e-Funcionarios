        </Pane>
        <Button id="add_tarefa" fx:id="Adicionar_tarefa" layoutX="618.0" layoutY="569.0" mnemonicParsing="false" onAction="#Btn_adicionar_tarefa" prefHeight="58.0" prefWidth="301.0" text="           Adicionar Tarefa" textFill="WHITE">
            <font>
                <Font size="16.0" />
            </font>
        </Button>
        <ImageView fitHeight="52.0" fitWidth="59.0" layoutX="648.0" layoutY="572.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@../../Imgs/icon_adicionar.png" />
            </image>
        </ImageView>
        <Pane id="painel_dados_prioriade" layoutX="580.0" layoutY="427.0" prefHeight="124.0" prefWidth="373.0">
            <Text layoutX="96.0" layoutY="36.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Selecione Prioridade">
