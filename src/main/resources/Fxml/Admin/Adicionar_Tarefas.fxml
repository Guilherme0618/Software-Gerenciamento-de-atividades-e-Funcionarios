               <ToggleGroup fx:id="grupoCores" />
            </toggleGroup>
            </RadioButton>
            <RadioButton id="rdb_2" fx:id="corAmarela" layoutX="147.0" layoutY="62.0" mnemonicParsing="false" text="Amarelo" textFill="#d7e822">
                <font>
                    <Font size="14.0" />
                </font>
            </RadioButton>
            <RadioButton id="rdb_3" fx:id="corVermelha" layoutX="262.0" layoutY="62.0" mnemonicParsing="false" text="Vermelho" textFill="#ff3636">
