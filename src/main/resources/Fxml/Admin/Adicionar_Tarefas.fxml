                    <Image url="@../../Imgs/caminho_data.gif" />
                </image>
            </ImageView>
        </Pane>
        <Pane id="painel_dados_user" layoutX="588.0" layoutY="22.0" prefHeight="380.0" prefWidth="358.0">
