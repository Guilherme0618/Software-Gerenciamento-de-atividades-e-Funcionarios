    </Button>
    <ImageView fitHeight="37.0" fitWidth="38.0" layoutX="43.0" layoutY="41.0" pickOnBounds="true" preserveRatio="true">
        <image>
          <Image url="@../../Imgs/voltar.png" />
        </image>
    </ImageView>
   <Text fill="#836262" layoutX="294.0" layoutY="67.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Todas as Informacoes Ficarão Gravadas no Banco de Dados" wrappingWidth="528.419921875">
      <font>
         <Font size="20.0" />
      </font>
   </Text>
   <ImageView fitHeight="52.0" fitWidth="61.0" layoutX="836.0" layoutY="34.0" pickOnBounds="true" preserveRatio="true">
      <image>
         <Image url="@../../Imgs/icon_database.gif" />
      </image>
   </ImageView>
</AnchorPane>
