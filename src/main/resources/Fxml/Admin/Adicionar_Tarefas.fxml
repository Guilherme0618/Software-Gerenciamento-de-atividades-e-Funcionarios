            <DatePicker id="data_fim" fx:id="data_fimTarefa" layoutX="290.0" layoutY="522.0" prefHeight="58.0" prefWidth="180.0" promptText="Data Termino" />
            <ImageView fitHeight="27.0" fitWidth="30.0" layoutX="228.0" layoutY="536.0" pickOnBounds="true" preserveRatio="true">
