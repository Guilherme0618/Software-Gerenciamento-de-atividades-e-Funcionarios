<AnchorPane id="PaneFundo" prefHeight="800.0" prefWidth="1023.0" stylesheets="@../../Styles/Adicionar_Tarefa.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.jdm.agenda.Controllers.Admin.AdicionarTarefasController">
    <Pane id="painel_fundo_dados" fx:id="painel_dadosTarefas" layoutX="28.0" layoutY="94.0" prefHeight="677.0" prefWidth="967.0">
        <Pane id="painel_dados_tarefa" layoutX="31.0" layoutY="22.0" prefHeight="619.0" prefWidth="528.0">
            <Text layoutX="210.0" layoutY="36.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Dados Tarefas">
                <font>
                    <Font size="20.0" />
                </font>
            </Text>
            <TextField id="nome_tarefa" fx:id="titulo_tarefa" layoutX="14.0" layoutY="103.0" prefHeight="44.0" prefWidth="358.0" promptText=" Nome Tarefa">
                <font>
                    <Font size="16.0" />
                </font>
            </TextField>
            <DatePicker id="data_inicio" fx:id="data_inicioTarefa" layoutX="14.0" layoutY="522.0" prefHeight="58.0" prefWidth="180.0" promptText="Data Início" />
